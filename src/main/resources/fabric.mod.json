{
  "schemaVersion": 1,
  "id": "legacy-lwjgl3",
  "version": "${version}",
  "name": "Legacy LWJGL3",
  "description": "A Grotesque hack to bring LWJGL 3 back to legacy versions of Minecraft.",
  "authors": [
    "All the LWJGL 2 and 3 people!",
    "gudenau",
    "Zarzelcow",
    "moehreag"
  ],
  "contact": {
    "sources": "https://github.com/moehreag/legacy-lwjgl3"
  },
  "license": "LGPL-2.1-only",
  "icon": "assets/legacy-lwjgl3/icon.png",
  "environment": "client",
  "entrypoints": {
	"preLaunch": [
	  "io.github.moehreag.legacylwjgl3.MacOSPreLaunch"
	],
    "client": [
	    "io.github.moehreag.legacylwjgl3.LegacyLWJGL3"
    ]
  },
  "mixins": [
    "legacy-lwjgl3.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "<1.13.0-alpha.17.43.a",
    "java": ">=17",
    "osl-lifecycle-events": ">=0.6.0"
  },
  "custom": {
	"loom:injected_interfaces": {
	  "net/minecraft/unmapped/C_85740840": [
		"io/github/moehreag/legacylwjgl3/LegacyLWJGL3ScreenEx"
	  ]
	}
  }
}
